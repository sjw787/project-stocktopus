# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stocktopus:stocktopus_dev@localhost:5432/stocktopus
POSTGRES_PASSWORD=stocktopus_dev

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Environment ────────────────────────────────────────────────────────────────
ENV=development

# ── LLM Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ACTIVE_LLM_PROVIDER=openai   # openai | anthropic

# ── Market Data / Broker (Alpaca) ──────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # paper trading
# ALPACA_BASE_URL=https://api.alpaca.markets       # live trading — Phase 9 only

# ── News Providers ─────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
NEWSAPI_API_KEY=

# ── Budget / Cost Controls ─────────────────────────────────────────────────────
LLM_DAILY_BUDGET_USD=5.00
DATA_MONTHLY_BUDGET_USD=50.00

# ── Trading Safety Caps (Phase 9) ──────────────────────────────────────────────
MAX_POSITION_USD=50
MAX_DAILY_LOSS_USD=25
NO_OVERNIGHT_HOLDS=true
NO_LEVERAGE=true
